# =================================================================
# Antigravity Headless Server Configuration
# =================================================================

# 1. Base Image
# Defaults to Ubuntu 26.04 LTS. For an ultra-light glibc alternative, use: debian:bookworm-slim
BASE_IMAGE=ubuntu:26.04

# 2. Instance Name
# Name of this server instance as it appears in the Antigravity Remote Control dashboard
RC_NAME=my-server-agent

# 3. Host Workspace & Git Projects Directory
# Point this to the directory on your host server where your Git repositories/projects live.
# Inside the container, this directory is mounted at /workspace.
# Examples:
#   WORKSPACE_DIR=/home/ubuntu/projects
#   WORKSPACE_DIR=./workspace
WORKSPACE_DIR=./workspace

# 4. User & Group IDs
# Match your host user's UID and GID to ensure seamless read/write permissions on workspace files
PUID=1000
PGID=1000

# 5. Optional Web Terminal (ttyd)
# Set to 'true' if you want a browser terminal for initial onboarding or fallback
ENABLE_WEB_TERMINAL=false
WEB_PORT_BINDING=127.0.0.1:7681

# Optional basic auth for the Web Terminal
WEB_TERMINAL_USER=admin
WEB_TERMINAL_PASS=changeme_secure_password
